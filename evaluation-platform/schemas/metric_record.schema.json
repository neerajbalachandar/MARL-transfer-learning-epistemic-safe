{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized metric record",
  "type": "object",
  "required": ["run_id", "seed", "metric_name", "original_metric_name", "canonical_category", "definition", "environment_applicability", "task_applicability", "value", "unit", "range", "direction", "aggregation_level", "benchmark_semantics_id", "source_file", "source_sha256", "source_condition", "target_condition", "checkpoint_step", "native_unit"],
  "properties": {
    "run_id": {"type": "string"}, "seed": {"type": ["integer", "null"]},
    "metric_name": {"type": "string"}, "original_metric_name": {"type": "string"},
    "canonical_category": {"type": "string"}, "definition": {"type": ["string", "null"]},
    "environment_applicability": {"type": "array", "items": {"type": "string"}},
    "task_applicability": {"type": "array", "items": {"type": "string"}},
    "value": {"type": ["number", "null"]},
    "unit": {"type": ["string", "null"]}, "range": {"type": ["array", "null"]},
    "direction": {"enum": ["higher", "lower", "target", "unknown"]},
    "aggregation_level": {"type": "string"}, "benchmark_semantics_id": {"type": ["string", "null"]},
    "source_file": {"type": "string"}, "source_sha256": {"type": "string"},
    "native_unit": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
